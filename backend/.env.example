DATABASE_URL=postgresql+asyncpg://autoreply:CHANGE_ME@127.0.0.1:5432/autoreply

# Long random strings: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

PUBLIC_BASE_URL=https://api.webhook.sigmaflux.in
CORS_ORIGINS=https://webhook.sigmaflux.in,http://localhost:3000

MEDIA_DIR=/data/media
